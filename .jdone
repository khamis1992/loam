  src/policy/commandRisk/__tests__/{assess,gate,paths,tokenize}.test.ts   (1301 lines, new)
  src/policy/__tests__/riskTier.test.ts                                    (+15)
  src/tools/__tests__/shellRisk.test.ts                                    (+165)
  src/policy/riskTier.ts                                                   (+32)
  src/tools/shell.ts                                                       (+29)
  THIRD_PARTY_NOTICES                                                      (+5)
