  "source": "shadcn/ui",
  "code": "export function DataTable({ rows }) {\n  return (\n    <Table>\n      <TableHeader><TableRow><TableHead>Name</TableHead><TableHead className=\"text-right\">Status</TableHead></TableRow></TableHeader>\n      <TableBody>\n        {rows.map((row) => (\n          <TableRow key={row.id}><TableCell>{row.name}</TableCell><TableCell className=\"text-right\"><Badge>{row.status}</Badge></TableCell></TableRow>\n        ))}\n      </TableBody>\n    </Table>\n  );\n}"
}
