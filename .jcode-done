  npx tsc --noEmit
  npm run build:server
  (cd packages/web && npx next build)
  npm run test:bench
  node --import tsx --test src/server/__tests__/sharedCodeSession.test.ts src/tools/__tests__/codeSession.test.ts
  (cd packages/web && npx vitest run)
  npm run check:encoding && npm run check:modes && npm run check:orchestrator && npm run check:promptwire

