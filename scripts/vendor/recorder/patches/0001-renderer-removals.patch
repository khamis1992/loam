diff --git a/src/lib/recorder/provider-registry.ts b/src/lib/recorder/provider-registry.ts
new file mode 100644
index 0000000..7642ffa
--- /dev/null
+++ b/src/lib/recorder/provider-registry.ts
@@ -0,0 +1,45 @@
+// Loam Recorder: the upstream LLM provider registry is removed (no in-app LLM
+// calls; the Loam agent drives the Recorder over its bridge). This stub keeps
+// the renderer's imports compiling with an empty provider list.
+export interface ProviderDefinition {
+	id: string;
+	label: string;
+	defaultModel: string;
+	authKind: "api-key";
+	supportsReasoningEffort: boolean;
+	requiresBaseUrl?: boolean;
+	setupHint?: string;
+	envKeys: string[];
+	baseUrl?: string;
+	wireProtocol?: "anthropic" | "openai";
+}
+
+export const PROVIDER_DEFINITIONS: ProviderDefinition[] = [];
+
+export const REASONING_EFFORT_OPTIONS = ["none"] as const;
+export type ReasoningEffort = "none" | "minimal" | "low" | "medium" | "high" | "xhigh";
+
+export const REASONING_EFFORT_LABELS: Record<ReasoningEffort, string> = {
+	none: "None",
+	minimal: "Minimal",
+	low: "Low",
+	medium: "Medium",
+	high: "High",
+	xhigh: "Extra high",
+};
+
+export function getReasoningEffortOptions(_providerId: string): readonly ReasoningEffort[] {
+	return REASONING_EFFORT_OPTIONS;
+}
+
+export function getReasoningEffortLabel(_providerId: string, effort: ReasoningEffort): string {
+	return REASONING_EFFORT_LABELS[effort];
+}
+
+export function normalizeProviderId(_provider?: string): string | undefined {
+	return undefined;
+}
+
+export function getProviderDefinition(_id: string): ProviderDefinition | undefined {
+	return undefined;
+}
