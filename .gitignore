# Per-task done reports and gate-failure logs are session markers, not project files.
/.cc-report-*.md
/.jgatefail.txt
/.github/workflows/release.yml

nul
/packages/web/e2e/report/
/packages/web/e2e/results/
/packages/web/e2e/visual/
/packages/web/e2e/snapshots/

# Vendored editor dists (fetched with `npm run vendor`; never committed)
/.cache/vendor/
# Coding-eval harness: the committed fixtures live in evals/coding/tasks/, but the
# generated sandboxes and reports are throwaway run output.
/evals/coding/results/

# Vendored wasm app bundles (fetched by scripts/vendor/fetch-craft.mjs; never committed)
electron/craft/*/dist/
electron/filmcraft/dist/

# jcode task markers (per .jtask.md: never commit these). A branch created from a
# parity tip where .jdone was untracked still carries it in the index, so merging
# manus-parity sees a modify/delete conflict on it; these patterns keep the marker
# from being committed again.
.jcode-done
.jdone
.jblocked

# throwaway local probe scripts (never commit)
tmp-*.mjs
tmp-*.mts


# loam-jcode runner markers (never commit)
.jdone.*.tmp
.cr-done
.cc-done
.neo-done
.devin-done
.jgatefail.txt
.jtask.md
