{
  "name": "loam",
  "version": "0.5.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Loam",
  "description": "Loam — local workspaces with focused tools and isolated tasks",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:encoding": "tsx src/scripts/check-encoding.ts --run",
    "check:pentest-bench": "tsx src/scripts/check-pentest-bench.ts",
    "test:pentest-bench": "node --import tsx --test src/scripts/__tests__/check-pentest-bench.test.ts",
    "test:browser-operator": "node --import tsx --test src/tools/__tests__/browserOperator.test.ts",
    "test:electron": "node --test electron/__tests__/inAppBrowser.test.cjs",
    "check:selfimprove": "tsx src/scripts/check-selfimprove.ts",
    "check:eval": "tsx src/scripts/check-eval.ts",
    "check:orchestrator": "tsx src/scripts/check-orchestrator.ts",
    "eval": "tsx src/scripts/eval-run.ts",
    "eval:selfplay": "tsx src/scripts/eval-selfplay.ts",
    "ft:export": "tsx src/scripts/ft-export.ts",
    "check:task-ui": "npm run check:loam-ui",
    "check:recovery": "tsx src/scripts/check-recovery.ts",
    "check:recovery:http": "tsx src/scripts/check-recovery-http.ts",
    "verify": "npm run typecheck && npm run check:encoding && npm run check:eval && npm run check:orchestrator && npm run check:recovery && npm run check:modes",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs --external:playwright --external:node-pty --external:@modelcontextprotocol/sdk --external:sharp --external:@nut-tree-fork/nut-js && node -e \"const fs=require('fs');fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.mjs','dist/pdf.worker.mjs');console.log('pdf worker copied to dist/')\"",
    "build:memory-skills": "esbuild addons/memory-skills-mcp/src/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=addons/memory-skills-mcp/dist/server.cjs --external:@modelcontextprotocol/sdk",
    "check:memory-skills": "tsc -p addons/memory-skills-mcp/tsconfig.json",
    "smoke:memory-skills": "node addons/memory-skills-mcp/test/smoke.mjs",
    "desktop": "npm run build:server && electron electron/main.cjs",
    "dist": "npm run build:icon && npm run build:server && electron-builder --win --publish never",
    "dist:publish": "npm run build:server && electron-builder --win --publish always",
    "feed:make": "node tools/update-feed/make-feed.mjs",
    "feed:serve": "node tools/update-feed/serve-feed.mjs",
    "feed:verify": "node tools/update-feed/verify-feed.mjs",
    "feed:verify:release": "node tools/update-feed/verify-release.mjs",
    "ollama:check": "tsx src/scripts/check-ollama.ts",
    "check:modes": "tsx src/scripts/check-modes.ts",
    "check:isolation": "tsx src/scripts/check-isolation-http.ts",
    "check:loam-ui": "tsx src/scripts/check-loam-ui.mjs",
    "check:promo-carousel": "node src/scripts/check-promo-carousel.mjs",
    "check:loam-ancillary": "node src/scripts/check-loam-ancillary.mjs",
    "check:loam-agents": "tsx src/scripts/check-loam-agents.ts",
    "check:loam-e2e": "tsx src/scripts/check-loam-e2e.ts",
    "check:local-model": "tsx src/scripts/check-local-model.ts",
    "verify:loam": "npm run verify && npm run check:isolation && npm run check:loam-agents && npm run check:loam-ui && npm run check:loam-ancillary && npm run check:loam-e2e",
    "build:icon": "node scripts/build-loam-icon.mjs",
    "check:live-services": "tsx src/scripts/check-live-services.ts",
    "check:mcp": "tsx src/scripts/check-mcp.ts",
    "check:packaged": "node src/scripts/check-packaged-loam.mjs",
    "check:studio": "tsx src/scripts/check-studio.ts",
    "check:studio-http": "tsx src/scripts/check-studio-http.ts",
    "check:studio-ui": "node src/scripts/check-studio-ui.mjs",
    "check:studio-export": "tsx src/scripts/check-studio-export.ts",
    "gen:master-prompt": "tsx src/scripts/gen-master-prompt.ts",
    "gen:web-app-template": "tsx src/scripts/gen-web-app-template.ts",
    "check:web-scaffold": "tsx src/scripts/check-web-scaffold.ts",
    "check:promptwire": "tsx src/scripts/check-promptwire.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@modelcontextprotocol/server-memory": "^1.0.0",
    "@modelcontextprotocol/server-sequential-thinking": "^1.0.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.12.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
