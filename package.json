    "dist": "npm run build:icon && npm run build:server && npm --prefix packages/web run build && npm run vendor && npm run vendor:craft && electron-builder --win --publish never",
    "dist:publish": "npm run build:server && electron-builder --win --publish always",
    "eval": "tsx src/scripts/eval-run.ts",
    "eval:audit-prompts": "tsx src/scripts/eval-audit-prompts.ts",
    "eval:coding": "tsx src/scripts/eval-coding.ts",
    "eval:coding-bench": "tsx src/scripts/eval-coding-bench.ts",
    "eval:coding-prompt": "tsx src/scripts/eval-coding-prompt.ts",
    "eval:design": "tsx src/scripts/eval-design.ts",
    "eval:neo": "tsx src/scripts/eval-neo.ts",
    "eval:selfplay": "tsx src/scripts/eval-selfplay.ts",
