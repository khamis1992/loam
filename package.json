    "test:bench": "node --import tsx --test bench/__tests__/fakeModel.test.ts bench/__tests__/rssSampler.test.ts bench/__tests__/memBench.test.ts bench/__tests__/appRamBench.test.ts bench/__tests__/launchers.test.ts bench/__tests__/rendererHibernationBench.test.ts",
    "test:bridges": "node --import tsx --test src/bridges/__tests__/*.test.ts",
    "test:browser-operator": "node --import tsx --test src/tools/__tests__/browserOperator.test.ts",
    "test:coding-eval": "node --import tsx --test src/scripts/__tests__/eval-coding.test.ts",
    "test:craft": "node --import tsx --test src/server/__tests__/craftStatus.test.ts",
    "test:design-pipeline": "node --import tsx --test src/design/__tests__/pipeline.test.ts src/models/__tests__/route.test.ts src/scripts/__tests__/check-design-pipeline.test.ts",
    "test:electron": "node --test electron/__tests__/inAppBrowser.test.cjs",
    "test:memory": "node --import tsx --test src/memory/__tests__/cache.test.ts src/memory/__tests__/caps.test.ts src/server/__tests__/debugMemory.test.ts src/protocol/__tests__/blobRoute.test.ts",
    "test:mirofish": "node --import tsx --test src/tools/mirofish/__tests__/nutrio-e2e.test.ts",
    "test:normalize": "node --import tsx --test src/security/normalize/__tests__/*.test.ts",
    "test:pentest-bench": "node --import tsx --test src/scripts/__tests__/check-pentest-bench.test.ts",
    "test:prune": "node --import tsx --test src/agent/prune/__tests__/*.test.ts src/tools/__tests__/contextRecallTool.test.ts",
    "test:red": "node --import tsx --test src/security/red/__tests__/*.test.ts",
    "test:remediate": "node --import tsx --test src/security/remediate/__tests__/*.test.ts",
    "test:remediate-packs": "node --import tsx --test src/security/remediate/__tests__/packs.test.ts",
    "test:remediate-inventory": "node --import tsx --test src/security/remediate/__tests__/inventory.test.ts",
    "test:remediate-resolve": "node --import tsx --test src/security/remediate/__tests__/resolve.test.ts",
    "test:remediate-gates": "node --import tsx --test src/security/remediate/__tests__/gates.test.ts",
    "test:remediate-rescan": "node --import tsx --test src/security/remediate/__tests__/rescan.test.ts",
    "test:remediate-pr": "node --import tsx --test src/security/remediate/__tests__/pr.test.ts",
    "test:remediate-fixgate": "node --import tsx --test src/security/remediate/__tests__/fixGate.test.ts",
    "test:remediate-orchestrator": "node --import tsx --test src/security/remediate/__tests__/orchestrator.test.ts",
    "test:scanners": "node --import tsx --test src/security/__tests__/scanners1.test.ts src/security/normalize/__tests__/*.test.ts",
    "test:security-extra": "node --import tsx --test src/security/__tests__/scanners1.test.ts src/security/__tests__/re1.test.ts src/security/__tests__/fuzz1.test.ts src/security/__tests__/bench1.test.ts",
    "test:vendor": "node --test scripts/vendor/__tests__/fetch-craft.test.mjs",
    "test:vendor:editors": "node --import tsx --test scripts/vendor/__tests__/*.test.mjs",
    "test:vendor:protocol": "node --test electron/__tests__/vendorProtocol.test.cjs electron/__tests__/filmcraftRebrand.test.mjs",
    "test:wiki": "node --import tsx --test src/wiki/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "vendor": "npm run vendor:filmcraft && npm run vendor:effectcraft",
    "vendor:craft": "node scripts/vendor/fetch-craft.mjs",
    "vendor:effectcraft": "node scripts/vendor/fetch-effectcraft.mjs",
    "vendor:filmcraft": "node scripts/vendor/fetch-filmcraft.mjs",
    "test:orchestration": "node --import tsx --test \"src/orchestration/**/__tests__/*.test.ts\" \"src/subagent/__tests__/acpClient.test.ts\"",
    "check:orchestration": "tsx src/scripts/check-orchestration.ts && npm run test:orchestration",
    "check:selfharden": "node --import tsx src/scripts/check-self-audit.ts",
    "check:memory-hybrid": "node --import tsx src/scripts/check-memory-hybrid.ts",
    "test:memory-hybrid": "node --import tsx --test src/memory/__tests__/hybrid.test.ts",
    "check:wakaru-bridge": "node --import tsx src/scripts/check-wakaru-bridge.ts",
    "test:wakaru-bridge": "node --import tsx --test src/bridges/__tests__/binaries.test.ts",
    "verify": "npm run typecheck && npm run check:encoding && npm run check:docs && npm run check:eval && npm run check:orchestrator && npm run check:recovery && npm run check:modes && npm run check:orchestration",
    "verify:loam": "npm run verify && npm run check:isolation && npm run check:loam-agents && npm run check:loam-ui && npm run check:loam-ancillary && npm run check:loam-e2e"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@modelcontextprotocol/server-memory": "^1.0.0",
    "@modelcontextprotocol/server-sequential-thinking": "^1.0.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.12.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.49.0",
    "pptxgenjs": "^4.0.1",
    "quickjs-emscripten-core": "^0.32.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@electron/fuses": "^1.8.0",
    "@jazzer.js/core": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
