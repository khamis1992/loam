{
  "name": "loam",
  "version": "0.5.31",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Loam",
  "description": "Loam — local workspaces with focused tools and isolated tasks",
  "scripts": {
    "bench:j1": "node --import tsx bench/launchers.ts",
    "bench:mem": "node --import tsx bench/memBench.ts",
    "bench:ram:app": "node --import tsx bench/appRamBench.ts --spawn",
    "bench:ram:renderer": "node --import tsx bench/rendererHibernationBench.ts",
    "build:icon": "node scripts/build-loam-icon.mjs",
    "build:memory-skills": "esbuild addons/memory-skills-mcp/src/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=addons/memory-skills-mcp/dist/server.cjs --external:@modelcontextprotocol/sdk",
    "build:server": "node -e \"require('./scripts/build-server.cjs')\"",
    "check:audit": "tsx src/scripts/check-audit.ts",
    "check:bridges": "tsx src/scripts/check-bridges.ts",
    "check:cua-allowlist": "tsx src/scripts/check-cua-allowlist.ts",
    "check:cua-mcp": "tsx src/scripts/check-cua-mcp.ts",
    "check:design-pipeline": "tsx src/scripts/check-design-pipeline.ts",
    "check:design-registry": "tsx src/scripts/check-design-registry.ts",
    "check:docs": "tsx src/scripts/check-docs-links.ts",
    "check:docs:write": "tsx src/scripts/check-docs-links.ts --write",
    "check:encoding": "tsx src/scripts/check-encoding.ts --run",
    "check:env-builds": "tsx src/scripts/check-env-builds.ts",
    "check:eval": "tsx src/scripts/check-eval.ts",
    "check:eventlog": "tsx src/scripts/check-eventlog.ts",
    "check:experience": "tsx src/scripts/check-experience.ts",
    "check:fuzz": "tsx src/scripts/check-fuzz.ts",
    "check:isolation": "tsx src/scripts/check-isolation-http.ts",
    "check:live-services": "tsx src/scripts/check-live-services.ts",
    "check:loam-agents": "tsx src/scripts/check-loam-agents.ts",
    "check:loam-ancillary": "node src/scripts/check-loam-ancillary.mjs",
    "check:loam-e2e": "tsx src/scripts/check-loam-e2e.ts",
    "check:loam-ui": "tsx src/scripts/check-loam-ui.mjs",
    "check:local-model": "tsx src/scripts/check-local-model.ts",
    "check:mcp": "tsx src/scripts/check-mcp.ts",
    "check:memory-skills": "tsc -p addons/memory-skills-mcp/tsconfig.json",
    "check:modes": "tsx src/scripts/check-modes.ts",
    "check:normalize": "tsx src/scripts/check-normalize.ts",
    "check:orchestrator": "tsx src/scripts/check-orchestrator.ts",
    "check:packaged": "node src/scripts/check-packaged-loam.mjs",
    "check:pentest-bench": "tsx src/scripts/check-pentest-bench.ts",
    "check:promo-carousel": "node src/scripts/check-promo-carousel.mjs",
    "check:promptwire": "tsx src/scripts/check-promptwire.ts",
    "check:prune": "tsx src/scripts/check-prune.ts",
    "check:re": "tsx src/scripts/check-re.ts",
    "check:rea-allowlist": "tsx src/scripts/check-rea-allowlist.ts",
    "check:rea-evidence": "tsx src/scripts/check-rea-evidence.ts",
    "check:rea-mcp": "tsx src/scripts/check-rea-mcp.ts",
    "check:recovery": "tsx src/scripts/check-recovery.ts",
    "check:remediate": "tsx src/scripts/check-remediate.ts",
    "check:recovery:http": "tsx src/scripts/check-recovery-http.ts",
    "check:red": "tsx src/scripts/check-red-lab.ts",
    "red:engines": "tsx src/scripts/red-install-engines.ts",
    "red:engage": "tsx src/scripts/red-engage.ts",
    "check:scanners": "tsx src/scripts/check-scanners.ts",
    "check:srt-policy": "tsx src/scripts/check-srt-policy.ts",
    "check:srt-session": "tsx src/scripts/check-srt-session.ts",
    "check:srt-bridge": "tsx src/scripts/check-srt-bridge.ts",
    "check:security-asar": "tsx src/scripts/check-security-asar.ts",
    "check:selfimprove": "tsx src/scripts/check-selfimprove.ts",
    "check:selfscan": "tsx src/scripts/check-selfscan.ts",
    "check:studio": "tsx src/scripts/check-studio.ts",
    "check:studio-e2e": "tsx src/scripts/check-studio-e2e.ts",
    "check:studio-export": "tsx src/scripts/check-studio-export.ts",
    "check:studio-http": "tsx src/scripts/check-studio-http.ts",
    "check:studio-ui": "node src/scripts/check-studio-ui.mjs",
    "check:task-ui": "npm run check:loam-ui",
    "check:test-isolation": "tsx src/scripts/check-test-isolation.ts",
    "check:web-scaffold": "tsx src/scripts/check-web-scaffold.ts",
    "check:wiki": "tsx src/scripts/check-wiki.ts",
