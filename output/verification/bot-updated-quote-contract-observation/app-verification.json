  "scenarios": [
    {
      "name": "API ناجح: صنف واحد 1000 سنت × 3 مع خصم 25% وشحن 500 → subtotal 3000 وdiscount 750 وtotal 2750",
      "steps": [
        { "action": "text", "selector": "h1", "value": "حاسبة عروض الأسعار" }
      ],
      "apiChecks": [
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"KB-001\",\"unitPriceCents\":1000,\"quantity\":3}],\"discountPercent\":25,\"shippingCents\":500}",
              "expectedJson": { "subtotalCents": 3000, "discountCents": 750, "shippingCents": 500, "totalCents": 2750 }
            }
          ],
          "statuses": [200]
        }
      ]
    },
    {
      "name": "API تقريب النصف للأعلى: 333 سنت بخصم 50% → discount 167 وtotal 166",
      "steps": [
        { "action": "text", "selector": "footer", "value": "POST /api/quote" }
      ],
      "apiChecks": [
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"ROUND-1\",\"unitPriceCents\":333,\"quantity\":1}],\"discountPercent\":50,\"shippingCents\":0}",
              "expectedJson": { "subtotalCents": 333, "discountCents": 167, "shippingCents": 0, "totalCents": 166 }
            }
          ],
          "statuses": [200]
        }
      ]
    },
