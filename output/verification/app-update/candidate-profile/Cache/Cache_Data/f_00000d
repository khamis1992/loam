      else if(t.hasAttribute('data-mix-pan')){const track=project.tracks.find(x=>x.id===t.dataset.mixPan);if(track){track.pan=Number(t.value);t.closest('label').querySelector('output').textContent=track.pan===0?'وسط':(track.pan<0?'يسار ':'يمان ')+Math.abs(Math.round(track.pan*100))+'%';const bus=engine?.buses?.get(track.id);if(bus)bus.pan.pan.value=Math.max(-1,Math.min(1,track.pan));}}
      else if(t.dataset.mixEqLow||t.dataset.mixEqMid||t.dataset.mixEqHigh){const band=t.dataset.mixEqLow?'low':t.dataset.mixEqMid?'mid':'high';const track=project.tracks.find(x=>x.id===(t.dataset.mixEqLow||t.dataset.mixEqMid||t.dataset.mixEqHigh));if(track){track.eq??={};track.eq[band]=Number(t.value);t.closest('label').querySelector('output').textContent=t.value+'dB';applyEqBus(track);}}
      else if(t.dataset.mixCompThreshold||t.dataset.mixCompRatio){const track=project.tracks.find(x=>x.id===(t.dataset.mixCompThreshold||t.dataset.mixCompRatio));if(track){track.compressor??={enabled:true};if(t.dataset.mixCompThreshold)track.compressor.threshold=Number(t.value);else track.compressor.ratio=Number(t.value);t.closest('label').querySelector('output').textContent=t.value+(t.dataset.mixCompThreshold?'dB':':1');applyEqBus(track);}}
      else if(t.hasAttribute('data-mix-duck-amount')){project.duck??={enabled:true};project.duck.amount=Number(t.value);t.closest('label').querySelector('output').textContent=Math.round(project.duck.amount*100)+'%';}
    });
    $(' [data-tl-mixer-rows]')?.addEventListener('change',e=>{const t=e.target;
      if(t.dataset.mixEqLow||t.dataset.mixEqMid||t.dataset.mixEqHigh||t.dataset.mixCompThreshold||t.dataset.mixCompRatio||t.hasAttribute('data-mix-duck-amount')){void run(()=>edit(()=>{void project;validateTimelineSafe();}));}
    });
    function validateTimelineSafe(){try{validateTimeline(project);}catch(error){throw error;}}
    $('[data-tl-mixer-rows]').addEventListener('change',e=>{const t=e.target;if(t.hasAttribute('data-mix-volume')){const track=project.tracks.find(x=>x.id===t.dataset.mixVolume);if(track)void run(()=>edit(()=>{project.tracks.find(x=>x.id===track.id).volume=track.volume;}));}else if(t.hasAttribute('data-mix-pan')){const track=project.tracks.find(x=>x.id===t.dataset.mixPan);if(track)void run(()=>edit(()=>{project.tracks.find(x=>x.id===track.id).pan=track.pan;}));}});
    dialog.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||busy)return;
      if(b.hasAttribute('data-mix-solo')){const id=b.dataset.mixSolo;void run(()=>edit(()=>{const track=project.tracks.find(x=>x.id===id);track.solo=!track.solo;}));return;}
      if(b.hasAttribute('data-mix-voice')){const id=b.dataset.mixVoice;void run(()=>edit(()=>{const track=project.tracks.find(x=>x.id===id);if(track.role==='voice')delete track.role;else track.role='voice';}));return;}
      if(b.hasAttribute('data-mix-mute')){const id=b.dataset.mixMute;void run(()=>edit(()=>{const track=project.tracks.find(x=>x.id===id);track.muted=!track.muted;}));return;}
      if(b.hasAttribute('data-tl-record')){void run(toggleRecord);return;}
    });
    async function toggleRecord(){
      const button=$('[data-tl-record]');
      if(recorder){recorder.stop();return;}
      if(!navigator.mediaDevices?.getUserMedia)throw Error('التسجيل غير متاح في هذا المتصفح.');
      const chosenInput=localStorage.getItem('loam-audio-input')||undefined;
    const stream=await navigator.mediaDevices.getUserMedia({audio:chosenInput?{deviceId:{exact:chosenInput}}:true});
      const mime=['audio/webm;codecs=opus','audio/webm'].find(type=>window.MediaRecorder?.isTypeSupported(type));
      if(!mime){stream.getTracks().forEach(track=>track.stop());throw Error('ترميز التسجيل غير مدعوم هنا.');}
      recorder=new MediaRecorder(stream,{mimeType:mime});recordingSince=Date.now();
      const chunks=[];recorder.ondataavailable=event=>{if(event.data.size)chunks.push(event.data);};
      recorder.onstop=async()=>{
        stream.getTracks().forEach(track=>track.stop());recorder=null;button.textContent='تسجيل تعليق صوتي';
        try{
          const blob=new Blob(chunks,{type:'audio/webm'});
          if(blob.size<500)throw Error('التسجيل فارغ؛ تحقق من الميكروفون.');
          const name='تعليق صوتي '+new Date().toISOString().slice(0,19).replace(/[:T]/g,'-')+'.webm';
          const file=new File([blob],name,{type:'audio/webm'});
          let duration=(Date.now()-recordingSince)/1000;
          try{const context=new (window.AudioContext||window.webkitAudioContext)();try{const decoded=await context.decodeAudioData(await file.arrayBuffer());if(Number.isFinite(decoded.duration)&&decoded.duration>0.2)duration=decoded.duration;}finally{void context.close();}}catch{/* elapsed time is the fallback when decoding fails */}
          if(!(duration>0.2))throw Error('مدة التسجيل غير صالحة.');
          const kind='audio';
          const stored=await uploadAsset(file,await identity());
          try{const probe=document.createElement('audio');probe.preload='metadata';probe.src='/api/media?taskId='+encodeURIComponent(await identity())+'&path='+encodeURIComponent(stored.path);await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('timeout')),10000);probe.addEventListener('loadedmetadata',()=>{clearTimeout(timer);resolve();},{once:true});probe.addEventListener('error',()=>{clearTimeout(timer);reject(Error('decode'));},{once:true});});if(Number.isFinite(probe.duration)&&probe.duration>0.2)duration=Math.min(duration,probe.duration);}catch{/* keep decoded/elapsed */}
          try{const response=await fetch('/api/timeline/probe?taskId='+encodeURIComponent(await identity()),{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({path:stored.path})});const info=await response.json();if(response.ok&&Number.isFinite(info.duration)&&info.duration>0.2)duration=Math.min(duration,info.duration);}catch{/* keep elapsed */}
          await edit(()=>{const track=destinationTrack('audio');if(!track)throw Error('لا مسار صوت مفتوح للتسجيل؛ افتح القفل.');const asset={id:uid(),name:name.slice(0,200),kind,duration,path:stored.path,bytes:stored.bytes};project.assets.push(asset);const clip=newClip(track,asset,engine.time);project.clips.push(clip);selected=clip.id;});
          status('سُجّل تعليق صوتي ('+duration.toFixed(1)+' ث) وأُضيف عند المؤشر.');
        }catch(error){status(error.message);}
      };
      recorder.start(250);
      const label=()=>{button.textContent=recorder?'إيقاف التسجيل ('+Math.round((Date.now()-recordingSince)/1000)+' ث)':'تسجيل تعليق صوتي';};
      label();const labelTimer=setInterval(()=>{if(!recorder){clearInterval(labelTimer);return;}label();},500);
    }
    meterTimer=setInterval(tickMeters,120);
    dialog.addEventListener('input',e=>{const t=e.target;if(t.hasAttribute('data-fx-search')){const query=t.value.trim();t.closest('[data-fx-panel]')?.querySelectorAll('[data-fx-add]').forEach(button=>{button.hidden=!!query&&!button.textContent.includes(query);});}});
    $('[data-tl-recover-list]').onclick=()=>void run(recoveries);
    $('[data-tl-list]').onclick=()=>void run(async()=>{const id=await identity(),response=await fetch('/api/files?taskId='+encodeURIComponent(id)+'&path=uploads&max=2000');if(response.status===404){status('لا توجد مشاريع محفوظة.');return;}const data=await response.json();if(!response.ok)throw Error(data.error);const files=data.entries.filter(f=>!f.dir&&f.name.endsWith('loam-timeline.json'));$('[data-tl-saved]').replaceChildren(new Option('اختر مشروعًا…',''),...files.map(f=>new Option(f.name,f.path)));$('[data-tl-saved]').hidden=!files.length;});
    $('[data-tl-saved]').onchange=e=>{const path=e.target.value;if(path)void run(async()=>{const id=await identity(),response=await fetch('/api/media?taskId='+encodeURIComponent(id)+'&path='+encodeURIComponent(path));if(!response.ok)throw Error('تعذّر فتح المشروع.');await openProject(await response.blob());});};

  }
  entry.addEventListener('click',open,{signal});signal.addEventListener('abort',()=>{disposed=true;clearTimeout(recoveryTimer);clearInterval(meterTimer);try{recorder?.stop();}catch{}if(dirty){const snapshot=structuredClone(project),version=++recoveryVersion;void identity().then(taskId=>saveRecovery({id:taskId+':'+recoveryWriter,taskId,modifiedAt:Date.now(),revision:version,project:snapshot})).catch(()=>{});}engine?.dispose();dialog?.remove();dialog=null;},{once:true});
