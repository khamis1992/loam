/* Application builder: conversation on the left, live canvas on the right. */
.build-studio { color-scheme:inherit; }
.build-studio .sidebar { display:none; }
.build-studio .sidebar.open { display:flex; position:fixed; inset-block:48px 0; inset-inline-start:0; width:248px; z-index:40; box-shadow:0 12px 40px #0008; }
.build-studio #menuToggle { display:inline-flex; }
