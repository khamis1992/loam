@import url('/assets/fonts/fonts.css');
@import url('/task-view.css');
:root {
  --bg: oklch(10.5% 0.018 262);
  --bg-2: oklch(13% 0.02 262);
  --panel: oklch(15.8% 0.022 262);
  --panel-2: oklch(19.5% 0.025 262);
  --panel-3: oklch(23.5% 0.028 262);
  --text: oklch(97% 0.008 255);
  --muted: oklch(68% 0.022 258);
  /* هوية النمط النشط: لون الواجهة كله يتبدّل مع تبديل النمط (--mode-hue) */
  --mode-hue: 215;
  --mode-hue-2: 268;
  --accent: oklch(72% 0.17 var(--mode-hue));
  --accent-2: oklch(61% 0.22 var(--mode-hue-2));
  --ok: oklch(73% 0.18 158);
  --err: oklch(64% 0.22 25);
  --warn: oklch(79% 0.16 78);
  --border: oklch(26% 0.026 262);
  --radius: 14px;
  --r: 14px;
  --btn-black: oklch(61% 0.22 var(--mode-hue-2));
  --shadow: 0 18px 46px rgba(0, 0, 0, 0.52);
  --stage: oklch(8.5% 0.015 262);
}

html[data-theme="light"] {
  --bg: oklch(97% 0.006 250);
  --bg-2: oklch(99.5% 0.002 250);
  --panel: oklch(100% 0 0);
  --panel-2: oklch(94.8% 0.008 250);
  --panel-3: oklch(91.5% 0.012 250);
  --text: oklch(16% 0.024 262);
  --muted: oklch(46% 0.022 262);
  --accent: oklch(52% 0.19 var(--mode-hue));
  --accent-2: oklch(50% 0.22 var(--mode-hue-2));
  --border: oklch(86% 0.014 255);
  --btn-black: oklch(50% 0.22 var(--mode-hue-2));
  --shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
  --stage: oklch(93.5% 0.01 250);
}


