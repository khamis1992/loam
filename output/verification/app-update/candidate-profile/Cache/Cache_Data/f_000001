body { font-family:"Readex Pro","Tajawal","Segoe UI",system-ui,sans-serif; font-size:14px; background:radial-gradient(750px 340px at 78% -8%,color-mix(in srgb,var(--accent-2) 20%,transparent),transparent 70%),var(--bg); }
h1 { font-size:28px; } h2 { font-size:18px; } .lede { font-size:14px; }
.primary { background:linear-gradient(135deg,var(--accent-2),var(--accent)); border-color:transparent; color:white; box-shadow:0 5px 16px color-mix(in srgb,var(--accent-2) 22%,transparent); }
.sidebar { width:332px; padding:0; flex-direction:row; overflow:hidden; background:var(--bg-2); }
.rail { display:flex; flex-direction:column; gap:7px; width:62px; flex-shrink:0; padding:16px 8px; border-inline-end:1px solid var(--border); background:color-mix(in srgb,var(--bg) 70%,transparent); overflow:auto; }
.rail-btn { display:flex; align-items:center; justify-content:center; min-height:42px; width:44px; flex-shrink:0; border:1px solid transparent; border-radius:11px; background:transparent; color:var(--muted); font-size:20px; }
.rail-btn:hover,.rail-btn.active { color:var(--accent); background:color-mix(in srgb,var(--accent) 12%,var(--panel)); border-color:color-mix(in srgb,var(--accent) 35%,var(--border)); }
.rail-sep { height:1px; background:var(--border); margin:8px 4px; } .rail-grow { flex:1; }
.sidebar-panel { width:270px; min-width:0; padding:20px 16px 12px; display:flex; flex-direction:column; overflow:auto; }
.brand { justify-content:flex-start; gap:10px; font-size:24px; letter-spacing:-.5px; margin-bottom:22px; } .brand small { display:block; font-size:10px; font-weight:400; letter-spacing:0; color:var(--muted); margin-top:7px; }
.new-task { margin-bottom:8px; font-size:13px; min-height:40px; } .side-label { margin:20px 4px 9px; font-size:10px; } .side-tasks { margin:0 4px; gap:6px; } .side-tasks a { padding:7px 0; } .mode-nav { grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; } .mode-nav a { font-size:11px; padding:8px; gap:6px; border:1px solid var(--border); background:var(--panel); }
.sidebar-service { display:block; border:1px solid var(--border); padding:12px; margin-top:22px; border-radius:10px; font-size:12px; } .sidebar-service span { display:block; color:var(--muted); font-size:10px; margin-top:4px; }
.side-foot { margin-top:auto; padding-top:24px; font-weight:700; } .side-foot span { display:block; font-weight:400; font-size:10px; color:var(--muted); }
.sidebar.collapsed { width:62px; } .sidebar.collapsed .sidebar-panel { display:none; }
.topbar { min-height:54px; padding:8px 24px; } .page { padding:28px 32px 48px; max-width:1240px; } .home { max-width:1140px; }
.home-hero { margin:8px 0 24px; } .home-hero h1 { font-size:30px; margin:10px 0; } .home-hero p { margin:0; }
.home-composer { border:1px solid color-mix(in srgb,var(--accent-2) 35%,var(--border)); background:linear-gradient(135deg,color-mix(in srgb,var(--accent-2) 5%,var(--panel)),var(--panel)); border-radius:16px; padding:18px; box-shadow:0 8px 30px #00000010; }
.home-composer>label { font-size:12px; color:var(--muted); } .home-composer textarea { display:block; width:100%; min-height:90px; background:transparent; border:0; padding:12px 0; }
.home-mode-chips { display:flex; flex-wrap:wrap; gap:6px; padding:12px 0; border-top:1px solid var(--border); } .home-mode-chips button { border:1px solid var(--border); background:var(--panel-2); color:var(--muted); border-radius:8px; padding:6px 10px; font-size:11px; min-height:34px; }
.home-mode-chips button[aria-pressed=true] { color:var(--accent); border-color:var(--accent); background:color-mix(in srgb,var(--accent) 12%,var(--panel)); }
.home-composer-footer { display:flex; justify-content:space-between; align-items:center; gap:10px; font-size:10px; } .home-composer-footer .primary { min-height:36px; font-size:12px; }
.section-heading { margin:24px 0 12px; } .section-heading .muted { font-size:11px; }
.mode-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; } .mode-card { padding:15px; border-radius:12px; } .mode-symbol { width:32px; height:32px; font-size:18px; margin-bottom:12px; color:var(--accent); background:color-mix(in srgb,var(--accent) 10%,var(--panel)); } .mode-card h3 { font-size:13px; } .mode-card p { font-size:11px; margin-bottom:12px; } .mode-open { font-size:10px!important; }
.mode-heading { margin-bottom:22px; } .form-card,.context-card { border-radius:14px; padding:20px; } .tool-item { padding-block:9px; }
.build-preview-label { color:var(--accent); background:var(--panel-2); border-color:var(--border); } .build-address { color:var(--muted); background:var(--bg-2); } .build-canvas,.build-start-stage .build-placeholder { background:var(--panel); } .build-placeholder { color:var(--text); } .build-placeholder p,.build-placeholder-note { color:var(--muted); } .build-mark { background:var(--panel-2); border-color:var(--border); color:var(--accent); } .build-studio .sidebar.open { width:332px; flex-direction:row; } dialog::backdrop { background:#080c18cc; }
@media(max-width:1100px) { .sidebar { width:292px; } .sidebar-panel { width:230px; padding-inline:12px; } .page { padding:24px; } .mode-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
@media(max-width:900px) { .sidebar { width:62px; } .sidebar-panel { display:none; } .sidebar.open { width:292px; position:fixed; inset-block:0; inset-inline-start:0; z-index:40; box-shadow:0 0 0 100vmax #080c1880; } .sidebar.open .sidebar-panel { display:flex; } #menuToggle { display:inline-flex; } #collapseBtn { display:none; } }
@media(max-width:720px) { .sidebar { display:none; width:292px!important; flex-direction:row; } .sidebar.open { display:flex; } .sidebar.open .sidebar-panel { display:flex; } .page { padding:20px 16px; } .home-hero h1 { font-size:25px; } .mode-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .mode-card { padding:12px; } .home-composer { padding:14px; } .home-composer-footer { flex-wrap:wrap; } .home-composer-footer .primary { margin-inline-start:auto; } .topbar { padding:8px 12px; } }
