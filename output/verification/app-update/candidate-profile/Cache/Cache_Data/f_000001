.build-studio .chat-body { grid-column:1; grid-row:2; direction:rtl; position:relative; }
.build-studio .task-toolbar { padding:6px 10px; gap:4px; }
.build-studio .task-toolbar [role=tab] { font-size:11px; padding:6px; }
.build-studio #taskWorkspace { display:none; }
.build-studio .timeline { padding:16px 12px; }
.build-studio .log-entry { background:transparent; border:0; padding:10px 2px; font-size:13px; }
