/* Original command workspace rules, retained from the previous UI. */
.sidebar {
  display: flex;
  flex-direction: row;
  padding: 0;
  gap: 0;
  width: 332px;
  min-width: 332px;
  background: color-mix(in srgb, var(--bg-2) 92%, transparent);
  backdrop-filter: blur(18px);
  border-inline-end: 1px solid var(--border);
}

.sidebar .rail {
  width: 62px;
  min-width: 62px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding: 12px 0;
  border-inline-end: 1px solid var(--border);
  background: color-mix(in srgb, var(--stage) 75%, var(--bg-2));
}
.sidebar .rail .rail-sep {
  width: 24px;
  height: 1px;
  background: var(--border);
  margin: 6px 0;
}
.sidebar .rail button.rail-btn,
.sidebar .rail a.rail-btn {
  width: 42px;
  height: 42px;
  min-height: 42px;
  padding: 0;
  border-radius: 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  text-decoration: none;
}
.sidebar .rail button.rail-btn:hover,
.sidebar .rail a.rail-btn:hover {
  background: var(--panel-2);
  border-color: var(--border);
  color: var(--text);
}
.sidebar .rail button.rail-btn.active,
.sidebar .rail a.rail-btn.active {
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent-2) 24%, transparent), color-mix(in srgb, var(--accent) 18%, transparent));
  border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  color: var(--accent);
  box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 22%, transparent);
}
.sidebar .rail button.rail-btn.active::before {
  content: "";
  position: absolute;
  inset-inline-end: -10px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 20px;
  border-radius: 3px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
}

.sidebar .sidebar-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 11px;
  padding: 14px;
}

.app.collapsed .sidebar { width: 62px; min-width: 62px; }
.app.collapsed .sidebar .sidebar-panel { display: none; }


.side-top { display: flex; align-items: center; gap: 6px; }
.logo { display: flex; align-items: center; gap: 10px; }
.logo-mark {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 0 20px color-mix(in srgb, var(--accent-2) 45%, transparent);
}
.logo-mark svg { width: 18px; height: 18px; }
.logo-text { display: flex; flex-direction: column; line-height: 1.15; }
.logo-title { font-size: 13.5px; font-weight: 800; letter-spacing: 0.4px; }
.logo-accent { color: var(--accent); }
.logo-sub { font-family: "JetBrains Mono", monospace; font-size: 9.5px; color: var(--muted); letter-spacing: 0.6px; }

.search-wrap { position: relative; display: flex; align-items: center; }
.search-wrap .search {
  width: 100%;
  padding-inline-start: 30px;
  padding-inline-end: 56px;
  background: var(--panel);
  font-size: 12.5px;
}
.search-ic { position: absolute; inset-inline-start: 10px; color: var(--muted); font-size: 14px; pointer-events: none; }
.kbd {
  position: absolute;
  inset-inline-end: 8px;
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1px 5px;
  background: var(--panel-2);
}

.side-section { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 6px; }
.side-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.side-list { overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
.side-list .item {
  padding: 8px 10px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: color-mix(in srgb, var(--panel) 60%, transparent);
  cursor: pointer;
  font-size: 12.5px;
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
  transition: all 0.14s ease;
}
.side-list .item:hover { background: var(--panel-2); border-color: var(--border); }
.side-list .item.active {
  background: color-mix(in srgb, var(--accent-2) 16%, var(--panel));
  border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
}
.side-list .item .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.side-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--border));
  border-radius: 12px;
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent-2) 12%, var(--panel)), var(--panel));
  text-decoration: none;
  color: var(--text);
}
.side-card:hover { border-color: var(--accent); transform: translateY(-1px); }
.sc-ic {
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}
.sc-t { font-size: 12px; font-weight: 600; line-height: 1.35; }
.sc-t small { display: block; color: var(--muted); font-size: 10.5px; font-weight: 400; }

.side-foot { display: flex; gap: 8px; align-items: center; }
.side-foot select {
  flex: 1;
  min-width: 0;
  font-family: "JetBrains Mono", monospace;
  font-size: 11.5px;
  background: var(--panel);
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-top: 8px;
  border-top: 1px solid var(--border);
}
.avatar {
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent-2), var(--ok));
  color: #fff;
  font-weight: 800;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.uc-t { font-size: 12px; font-weight: 600; line-height: 1.25; }
.uc-t small { display: block; color: var(--muted); font-size: 10px; font-weight: 400; }


.topbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 22px;
  min-height: 52px;
  background: color-mix(in srgb, var(--bg-2) 84%, transparent);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}

.ver-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 5px 13px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.4px;
}
.loam-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ok);
  box-shadow: 0 0 10px var(--ok);
}
.ver-tag {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  color: #fff;
  padding: 1px 7px;
  border-radius: 999px;
}
.ver-pill .chev { color: var(--muted); font-size: 11px; }

.hud-pills {
  display: flex;
  align-items: center;
  gap: 6px;
}
.hud-pill {
  font-family: "JetBrains Mono", monospace;
  font-size: 11px;
  color: var(--muted);
  background: color-mix(in srgb, var(--panel) 75%, transparent);
  border: 1px solid var(--border);
  padding: 3px 10px;
  border-radius: 999px;
  direction: ltr;
}
.hud-pill b { color: var(--accent); }

.crumb { font-size: 13px; color: var(--muted); }
.crumb:not(:empty)::before { content: "/"; margin-inline-end: 8px; opacity: 0.5; }

.credits-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid color-mix(in srgb, var(--ok) 38%, var(--border));
  border-radius: 999px;
  background: color-mix(in srgb, var(--ok) 10%, var(--panel));
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text);
}
.spark { color: var(--ok); }


.home {
  position: relative;
  width: 100%;
  max-width: 1260px;
  margin: 0 auto;
  padding: 22px 28px 40px;
  overflow-y: auto;
}

.hero-glow {
  position: absolute;
  inset-inline: 0;
  top: -50px;
  height: 340px;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(620px 240px at 50% 25%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 72%),
    radial-gradient(460px 200px at 20% 55%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 72%);
  filter: blur(12px);
}

.home-hero {
  position: relative;
  z-index: 1;
  text-align: right;
  margin-bottom: 18px;
}

.hero-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 12px;
}

.status-beacon {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: "JetBrains Mono", monospace;
  font-size: 11px;
  font-weight: 600;
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, var(--panel));
  border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
  padding: 5px 13px;
  border-radius: 999px;
}
.beacon-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 10px var(--accent);
}

.promo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--accent-2) 45%, var(--border));
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent-2) 22%, var(--panel)), var(--panel));
  color: var(--text);
  font-size: 12px;
}
.promo:hover {
  border-color: var(--accent);
  transform: translateY(-1px);
}
.promo-badge {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 700;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  color: #fff;
  padding: 2px 8px;
  border-radius: 999px;
}
.promo-t { font-weight: 700; }

.loam-headline {
  font-size: 30px;
  font-weight: 800;
  margin: 0 0 6px;
  letter-spacing: -0.4px;
}
.grad-text {
  background: linear-gradient(135deg, var(--accent), var(--accent-2), var(--ok));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.home-tag {
  color: var(--muted);
  font-size: 13.5px;
  margin: 0;
  max-width: 880px;
  line-height: 1.6;
}

/* Centerpiece Omni-Command Console */


.home-composer {
  position: relative;
  z-index: 2;
  margin: 0 0 22px;
  padding: 14px 18px;
  border-radius: 18px;
  border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
  background: linear-gradient(180deg, color-mix(in srgb, var(--panel) 96%, transparent), color-mix(in srgb, var(--bg-2) 96%, transparent));
  box-shadow: var(--shadow);
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
}
.home-composer:focus-within {
  border-color: var(--accent);
  box-shadow: 0 20px 52px color-mix(in srgb, var(--accent-2) 22%, transparent);
}
.home-composer #homePrompt {
  flex: 0 0 auto;
  background: transparent;
  border: none;
  padding: 6px 2px;
  min-height: 68px;
  max-height: 300px;
  font-size: 14.5px;
  line-height: 1.65;
}
.composer-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  padding-bottom: 8px;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
}
.cchip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 5px 11px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  background: var(--panel-2);
}
.cchip:hover { border-color: var(--accent); background: var(--panel-3); }
.cchip svg { width: 14px; height: 14px; color: var(--accent); }
.sq { width: 10px; height: 10px; border: 1.5px solid var(--accent); border-radius: 3px; display: inline-block; }
.shield { color: var(--ok); font-weight: 800; }
.cchip[aria-pressed="false"] { color: var(--muted); }
.cchip[aria-pressed="false"] .shield { color: var(--muted); }

.composer-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}
.composer-hint {
  font-size: 11.5px;
  color: var(--muted);
  margin-inline-start: 6px;
}
.plus-btn {
  width: 36px;
  height: 36px;
  min-width: 36px;
  padding: 0;
  border-radius: 10px;
  font-size: 18px;
  background: var(--panel-2);
}
.send {
  width: 40px;
  height: 40px;
  min-width: 40px;
  padding: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  border-color: transparent;
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  box-shadow: 0 6px 18px color-mix(in srgb, var(--accent-2) 40%, transparent);
}
.send:hover { filter: brightness(1.1); transform: translateY(-1px); }
#micBtn.recording { background: var(--err); border-color: var(--err); color: #fff; }
.composer-note { margin-top: 4px; font-size: 12px; color: var(--accent); }

/* 6-Pillar Frontier Studio Matrix */
.home-actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.f-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: right;
  padding: 18px;
  border-radius: 16px;
  border: 1px solid var(--border);
  background: linear-gradient(160deg, color-mix(in srgb, var(--panel) 95%, transparent), color-mix(in srgb, var(--bg-2) 90%, transparent));
  gap: 8px;
  position: relative;
  overflow: hidden;
  transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}
.f-card:hover {
  transform: translateY(-3px);
  border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  box-shadow: var(--shadow);
}
.f-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.f-icon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: var(--panel-2);
  border: 1px solid var(--border);
}
.f-icon.cyan { background: color-mix(in srgb, var(--accent) 16%, var(--panel)); border-color: color-mix(in srgb, var(--accent) 35%, transparent); }
.f-icon.emerald { background: color-mix(in srgb, var(--ok) 16%, var(--panel)); border-color: color-mix(in srgb, var(--ok) 35%, transparent); }
.f-icon.amber { background: color-mix(in srgb, var(--warn) 16%, var(--panel)); border-color: color-mix(in srgb, var(--warn) 35%, transparent); }
.f-icon.violet { background: color-mix(in srgb, var(--accent-2) 18%, var(--panel)); border-color: color-mix(in srgb, var(--accent-2) 38%, transparent); }
.f-icon.rose { background: rgba(244, 63, 94, 0.14); border-color: rgba(244, 63, 94, 0.35); }
.f-icon.red { background: color-mix(in srgb, var(--err) 16%, var(--panel)); border-color: color-mix(in srgb, var(--err) 35%, transparent); }

.f-tag {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 700;
  color: var(--muted);
  background: var(--panel-2);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 999px;
}
.f-card-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  margin-top: 2px;
}
.f-card-desc {
  font-size: 12.5px;
  color: var(--muted);
  line-height: 1.55;
  flex: 1;
}
.f-card-foot {
  width: 100%;
  padding-top: 8px;
  margin-top: 4px;
  border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  font-family: "JetBrains Mono", monospace;
  font-size: 10.5px;
  color: var(--accent);
}


.modes-strip {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0 0 14px 0;
  padding: 14px;
  border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--border));
  border-radius: var(--radius);
  background:
    radial-gradient(480px 140px at 90% 0%, color-mix(in srgb, var(--accent-2) 16%, transparent), transparent 70%),
    color-mix(in srgb, var(--panel) 55%, transparent);
  box-shadow: var(--shadow);
  transition: border-color 0.4s ease, background 0.4s ease;
}
.modes-strip-head {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.active-mode-hero {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, transparent), color-mix(in srgb, var(--accent-2) 10%, transparent));
  font-size: 12.5px;
  transition: all 0.4s ease;
}
.active-mode-hero .am-icon {
  font-size: 19px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: color-mix(in srgb, var(--accent) 18%, transparent);
}
.active-mode-hero .am-text { display: flex; flex-direction: column; line-height: 1.25; }
.active-mode-hero .am-text b { font-size: 12.5px; }
.active-mode-hero .am-text small { font-size: 10.5px; color: var(--muted); }
.modes-hint { font-size: 11px; color: var(--muted); margin-inline-start: auto; }
.modes-chips {
  display: flex;
  gap: 7px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: thin;
}
.mchip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 13px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--panel-2) 70%, transparent);
  color: var(--muted);
  font-family: inherit;
  font-size: 11.5px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.18s ease;
}
.mchip:hover {
  color: var(--text);
  border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  transform: translateY(-1px);
}
.mchip.active {
  background: linear-gradient(135deg, var(--accent-2), var(--accent));
  border-color: transparent;
  color: #fff;
  box-shadow: 0 4px 16px color-mix(in srgb, var(--accent-2) 40%, transparent);
}
.mchip .mc-ic { font-size: 14px; }
.mchip .mc-t { max-width: 140px; overflow: hidden; text-overflow: ellipsis; }

/* Sidebar modes list */
.side-modes {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5px;
  max-height: 118px;
  overflow-y: auto;
  padding-inline-end: 2px;
  scrollbar-width: thin;
}
.smchip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--panel-2) 60%, transparent);
  color: var(--muted);
  font-family: inherit;
  font-size: 10.5px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-align: right;
  transition: all 0.16s ease;
}
.smchip span:last-child { overflow: hidden; text-overflow: ellipsis; }
.smchip:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }


/* Adapt the original shell to task-scoped Loam routes, without changing its geometry. */
:root { --mode-hue:268; --mode-hue-2:215; }
body { line-height:normal; }
.grow {flex:1;}.sidebar{min-width:332px;}.sidebar-panel {width:270px;overflow:hidden;}.sidebar.collapsed{min-width:62px;}.new-task{margin:0;min-height:37px;padding:8px 10px;font-size:14px;font-weight:700;}.side-label{margin:0;}.side-tasks{margin:0;}.side-list .item{font-weight:600;color:var(--text);white-space:normal;}.side-list .pill{font-size:11px;padding:2px 10px;line-height:1.4;}.side-list .pill.done{border-color:color-mix(in srgb,var(--ok) 50%,transparent);background:color-mix(in srgb,var(--ok) 9%,transparent);}.side-list .pill.error{border-color:var(--err);background:color-mix(in srgb,var(--err) 9%,transparent);}.side-foot{padding:0;margin:0;}.logo-title .logo-accent{display:block;}.side-top .icon{min-width:22px;min-height:28px;padding:2px;background:none;border:0;font-size:16px;}.logo-mark{font-size:27px;}.mode-nav a.smchip{padding:5px 9px;font-size:10.5px;gap:6px;}.topbar{height:54px;min-height:54px;}.topbar .crumb{display:none;}.topbar .icon{border:0;background:none;min-width:24px;min-height:24px;padding:0;color:var(--muted);}#menuToggle{display:inline-flex;}.connection::before{display:none;}.connection{font-size:12px;color:inherit;}.home{overflow:visible;}.home-hero{margin:0 0 18px;}.home-hero h1{font-size:30px;line-height:1.4;margin:0 0 6px;}.home-hero p{max-width:880px;line-height:1.6;font-size:13.5px;margin:0;}.home-composer{display:flex;}.home-composer #homePrompt{width:100%;min-height:98px;resize:vertical;outline:none;}.home-mode-chips{flex-wrap:nowrap;border:0;padding:0 0 4px;}.home-mode-chips button.mchip{font-size:11.5px;min-height:35px;border-radius:999px;padding:7px 13px;white-space:nowrap;}.home-mode-chips button[aria-pressed=true]{background:color-mix(in srgb,var(--accent) 12%,var(--panel));color:var(--text);}.home-composer .composer-hint{margin:0 6px 0 0;}.home-composer .send{min-height:40px;}.home-actions .f-card{padding:18px;border-radius:16px;min-height:187px;}.home-actions .f-card-title{font-size:15px;margin:2px 0 0;line-height:1.5;}.home-actions .f-card-desc{font-size:12.5px;margin:0;}.home-actions .f-card-foot{margin-top:4px;}.home-actions{gap:14px;}.home .section-heading{position:relative;z-index:1;}*::-webkit-scrollbar{width:7px;height:7px;}*::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--muted) 32%,transparent);border-radius:99px;}
@media(max-width:1100px){.hud-pills{display:none;}.home-actions{grid-template-columns:repeat(2,minmax(0,1fr));}.sidebar{width:332px;}.sidebar-panel{width:270px;}}
@media(max-width:900px){.sidebar{width:62px;min-width:62px;}.sidebar.open{width:332px;min-width:332px;}.sidebar.open .sidebar-panel{display:flex;}.sidebar:not(.open) .sidebar-panel{display:none;}.hero-top-row{align-items:flex-start;}.composer-hint{max-width:210px;}.home{padding:22px 20px 40px;}}
@media(max-width:720px){.sidebar.open{width:min(332px,100vw)!important;min-width:0;}.sidebar-panel{width:calc(100vw - 62px);}.topbar{padding:10px 12px;gap:6px;}.credits-chip{padding:5px 8px;}.ver-pill{font-size:10px;padding:5px 8px;gap:5px;}.ver-tag{display:none;}.home{padding:22px 16px 40px;}.home-hero h1{font-size:25px;}.hero-top-row{gap:10px;}.status-beacon{font-size:9px;padding:5px 8px;}.promo{font-size:10px;padding:6px 8px;gap:6px;}.promo-badge{font-size:8px;}.home-composer{padding:14px;}.home-composer .composer-bar{flex-wrap:wrap;}.home-composer .composer-hint{font-size:10px;order:5;max-width:none;width:100%;}.modes-hint{font-size:10px;}.home-actions{grid-template-columns:minmax(0,1fr);}.home-actions .f-card{min-height:187px;}.build-studio .sidebar.open{min-width:0;}}

/* The bundled studio pages keep their own styles; only navigation is shared. */
.studio-navigation .side-modes{grid-template-columns:minmax(0,1fr)}
.studio-navigation .smchip{white-space:normal!important;line-height:1.5}
.sidebar-panel{overflow-y:auto}
.studio-task-context{padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--panel)}
.studio-task-context a{font-size:13px;color:var(--accent)}
.studio-task-context p{font-size:12px;color:var(--muted);margin:8px 0 0}
/* One navigation column: destinations, tools, then recent work. */
.loam-shell .sidebar{width:280px;min-width:280px;flex-direction:column}
.loam-shell .sidebar .sidebar-panel{width:100%;padding:16px 14px 12px;gap:12px;overflow-y:auto;display:flex}
.loam-shell .sidebar.collapsed{display:none}
.loam-shell .sidebar .side-top{min-height:36px;flex-shrink:0}
.loam-shell .sidebar .logo-title{font-size:20px;letter-spacing:0}
.loam-shell .sidebar .logo-sub{font-family:inherit;font-size:10px;letter-spacing:0;line-height:1.6;margin-top:2px}
.loam-shell .sidebar #navBack,.loam-shell .sidebar #navFwd{display:none}
.loam-shell .sidebar #collapseBtn{display:inline-flex;min-width:32px;min-height:32px}
.workspace-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}
.workspace-nav a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:10px 4px;border-radius:9px;color:var(--muted);font-size:12px;min-height:58px}
.workspace-nav a:hover,.workspace-nav a.active,.workspace-tools a:hover,.workspace-tools a.active{background:var(--panel-2);color:var(--accent)}
.workspace-tools{flex-shrink:0;border-block:1px solid var(--border);padding-block:6px}
.workspace-tools summary{display:flex;align-items:center;gap:9px;cursor:pointer;padding:8px 5px;color:var(--muted);font-size:12px;list-style:none;min-height:36px}
.workspace-tools summary::-webkit-details-marker{display:none}
.workspace-tools summary::after{content:'⌄';margin-inline-start:auto}
.workspace-tools[open] summary::after{content:'⌃'}
.workspace-tools nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding-bottom:6px}
.workspace-tools a{display:flex;align-items:center;gap:8px;border-radius:7px;padding:9px 6px;font-size:12px;color:var(--muted)}
.workspace-nav a:focus-visible,.workspace-tools summary:focus-visible,.workspace-tools a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.loam-shell .sidebar .side-section{min-height:110px}
.loam-shell .sidebar .side-list .item{min-height:37px;flex-shrink:0;background:transparent;padding:8px 6px;font-weight:500}
.loam-shell .sidebar .side-list .item:hover,.loam-shell .sidebar .side-list .item.active{background:var(--panel-2)}
.loam-shell .sidebar .side-list .pill{font-size:10px;padding:1px 6px}
.loam-shell .sidebar .side-foot{border-top:1px solid var(--border);padding-top:10px;flex-shrink:0}
.loam-shell .sidebar .side-foot select{min-width:0;flex:1;width:100%;font-size:11px}
.loam-shell .sidebar .user-chip{flex-shrink:0}
@media(max-width:900px){.loam-shell .sidebar{display:none}.loam-shell .sidebar.open{display:flex;width:min(280px,100vw)!important;min-width:0;position:fixed;inset-block:0;inset-inline-start:0;z-index:40}.loam-shell .sidebar.open .sidebar-panel{display:flex;width:100%}}
/* A persistent route back/home path, independent of the side panel and iframe. */
.journey-nav{display:flex;align-items:center;gap:12px;flex-wrap:wrap;flex-shrink:0;min-height:48px;padding:7px 24px;border-bottom:1px solid var(--border);font-size:12px;background:var(--bg-2)}
.journey-nav[hidden]{display:none}
.journey-nav button{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:5px 12px;border:1px solid var(--border);border-radius:8px;background:var(--panel);color:var(--text);font:inherit;cursor:pointer}
.journey-nav a{color:var(--accent);padding-block:7px}.journey-nav [aria-current]{color:var(--muted);overflow-wrap:anywhere;min-width:0}
.journey-nav [data-journey-parent]:empty{display:none}.journey-nav [aria-current]::before,.journey-nav [data-journey-parent]:not(:empty)::before{content:'/';margin-inline-end:12px;color:var(--muted)}
.journey-nav a:focus-visible,.journey-nav button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
@media(max-width:720px){.journey-nav{padding:6px 12px;gap:9px;font-size:11px}.journey-nav [aria-current]{flex-basis:100%}.journey-nav [aria-current]::before{content:none}}
.app-updates h2{margin:0;font-size:18px}.update-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.update-heading [data-update-badge]{color:var(--accent);font-size:12px}.update-actions{display:flex;gap:10px;flex-wrap:wrap}.app-updates progress{width:100%;accent-color:var(--accent);height:10px}.app-updates [hidden]{display:none}.app-updates [data-update-status]{min-height:24px;overflow-wrap:anywhere}
