.office-object-inspector input[type=number]{width:104px!important;box-sizing:border-box;padding:6px 8px!important;direction:ltr;text-align:left;font-variant-numeric:tabular-nums}
.office-grid td input,.office-grid td textarea{text-align:inherit}
