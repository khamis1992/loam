          "statuses": [400, 400, 400, 400]
        },
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":100,\"quantity\":0}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
