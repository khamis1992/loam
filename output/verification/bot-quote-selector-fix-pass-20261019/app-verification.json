        { "action": "click", "selector": "#add-item" },
        { "action": "count", "selector": ".item-row", "count": 2 },
        { "action": "fill", "selector": "#sku-1", "value": "DUP-001" },
        { "action": "fill", "selector": "#price-1", "value": "100" },
        { "action": "fill", "selector": "#qty-1", "value": "1" },
        { "action": "fill", "selector": "#sku-2", "value": "DUP-001" },
        { "action": "fill", "selector": "#price-2", "value": "100" },
        { "action": "fill", "selector": "#qty-2", "value": "1" },
