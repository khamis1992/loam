    {
      "name": "API: رفض 400 لقيم سعر الوحدة والكمية غير الصالحة (نص، null، عدد عشري، خارج النطاق، سالب)",
      "steps": [
        { "action": "visible", "selector": "#calculate" }
      ],
      "apiChecks": [
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":\"100\",\"quantity\":1}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":null,\"quantity\":1}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":10.5,\"quantity\":1}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":10000001,\"quantity\":1}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            }
          ],
          "statuses": [400, 400, 400, 400]
        },
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":-1,\"quantity\":1}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":100,\"quantity\":\"2\"}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":100,\"quantity\":null}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":100,\"quantity\":1.5}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
            }
