        { "action": "count", "selector": ".item-row", "count": 1 },
        { "action": "click", "selector": "#items-list .item-row:last-child .remove-item" },
        { "action": "count", "selector": ".item-row", "count": 0 },
        { "action": "visible", "selector": "#items-empty" },
