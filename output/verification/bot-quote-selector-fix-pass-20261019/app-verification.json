              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"X\",\"unitPriceCents\":100,\"quantity\":10001}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "error": "invalid" }
