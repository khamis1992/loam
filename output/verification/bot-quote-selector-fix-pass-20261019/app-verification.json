    {
      "name": "واجهة: ظهور RTL والتدرجات السماوية والبنفسجية مع إضافة صنف وحذفه",
      "steps": [
        { "action": "count", "selector": "html[lang=ar][dir=rtl]", "count": 1 },
        { "action": "count", "selector": ".glow-cyan", "count": 1 },
        { "action": "count", "selector": ".glow-violet", "count": 1 },
        { "action": "visible", "selector": "#calculate" },
        { "action": "count", "selector": ".item-row", "count": 1 },
        { "action": "click", "selector": "#add-item" },
        { "action": "count", "selector": ".item-row", "count": 2 },
        { "action": "visible", "selector": "#items-list .item-row:last-child .sku-input" },
        { "action": "click", "selector": "#items-list .item-row:last-child .remove-item" },
        { "action": "count", "selector": ".item-row", "count": 1 },
        { "action": "count", "selector": "#items-empty:not([hidden])", "count": 0 }
      ]
    },
    {
      "name": "واجهة: عرض المجاميع الأربعة بوضوح بعد طلب ناجح (صنفان، خصم 10%، شحن 500)",
      "steps": [
        { "action": "fill", "selector": "#sku-1", "value": "KB-001" },
        { "action": "fill", "selector": "#price-1", "value": "1500" },
        { "action": "fill", "selector": "#qty-1", "value": "3" },
        { "action": "click", "selector": "#add-item" },
        { "action": "count", "selector": ".item-row", "count": 2 },
        { "action": "fill", "selector": "#sku-2", "value": "KB-002" },
        { "action": "fill", "selector": "#price-2", "value": "2000" },
        { "action": "fill", "selector": "#qty-2", "value": "2" },
        { "action": "fill", "selector": "#discount", "value": "10" },
        { "action": "fill", "selector": "#shipping", "value": "500" },
        { "action": "click", "selector": "#calculate" },
        { "action": "visible", "selector": "#results-panel" },
        { "action": "text", "selector": "#result-subtotal", "value": "8,500" },
        { "action": "text", "selector": "#result-discount", "value": "850" },
        { "action": "text", "selector": "#result-shipping", "value": "500" },
        { "action": "text", "selector": "#result-total", "value": "8,150" },
        { "action": "count", "selector": "#error-box:not([hidden])", "count": 0 }
      ],
      "expectedResponses": [
        { "method": "POST", "path": "/api/quote", "status": 200, "count": 1 }
      ]
    },
