{
  "entry": "index.html",
  "runtime": {
    "type": "node",
    "entry": "server.mjs"
  },
  "scenarios": [
    {
      "name": "API: طلب صالح بصنفين مع خصم 15% وشحن 2500 يعيد 200 بالحقول الأربعة فقط بقيم مطابقة يدويًا (الشحن خارج حساب الخصم)",
      "steps": [
        { "action": "text", "selector": "h1", "value": "حاسبة عروض الأسعار" },
        { "action": "visible", "selector": "#calculate" }
      ],
      "apiChecks": [
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"KB-001\",\"unitPriceCents\":1250,\"quantity\":3},{\"sku\":\"KB-002\",\"unitPriceCents\":9999,\"quantity\":2}],\"discountPercent\":15,\"shippingCents\":2500}",
              "expectedJson": { "subtotalCents": 23748, "discountCents": 3562, "shippingCents": 2500, "totalCents": 22686 }
            }
          ],
          "statuses": [200]
        }
      ]
    },
    {
      "name": "API: الحالات الحدية المقبولة (سعر 0 و10000000، كمية 1 و10000، خصم 0 و100، شحن 0 و1000000، سقف المجموع 1000000000 بالضبط، وتقريب النصف للأعلى)",
      "steps": [
        { "action": "visible", "selector": "#calculate" }
      ],
      "apiChecks": [
        {
          "requests": [
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"ZERO-PRICE\",\"unitPriceCents\":0,\"quantity\":10000}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "subtotalCents": 0, "discountCents": 0, "shippingCents": 0, "totalCents": 0 }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"MAX-PRICE\",\"unitPriceCents\":10000000,\"quantity\":1}],\"discountPercent\":100,\"shippingCents\":1000000}",
              "expectedJson": { "subtotalCents": 10000000, "discountCents": 10000000, "shippingCents": 1000000, "totalCents": 1000000 }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"HALF-UP\",\"unitPriceCents\":2501,\"quantity\":1}],\"discountPercent\":50,\"shippingCents\":0}",
              "expectedJson": { "subtotalCents": 2501, "discountCents": 1251, "shippingCents": 0, "totalCents": 1250 }
            },
            {
              "method": "POST",
              "path": "/api/quote",
              "body": "{\"items\":[{\"sku\":\"SUBTOTAL-CAP\",\"unitPriceCents\":100000,\"quantity\":10000}],\"discountPercent\":0,\"shippingCents\":0}",
              "expectedJson": { "subtotalCents": 1000000000, "discountCents": 0, "shippingCents": 0, "totalCents": 1000000000 }
            }
          ],
          "statuses": [200, 200, 200, 200]
        }
      ]
    },
    {
